          "order": 3,
          "y": 290.0,
          "note": "请求生成发射信号"
        },
        {
          "id": "msg_return_tx_signal",
          "from_lifeline": "life_tx_coordinator",
          "to_lifeline": "life_user",
          "label": "return txSignal",
          "type": "association",
          "order": 4,
