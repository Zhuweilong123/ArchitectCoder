      "messages": [
        {
          "id": "msg_setmode",
          "from_lifeline": "life_user",
          "to_lifeline": "life_mode_controller",
          "label": "setMode(LongRange)",
          "type": "association",
          "order": 1,
          "y": 190.0,
          "note": "用户切换至远程模式"
        },
        {
          "id": "msg_return_params",
          "from_lifeline": "life_mode_controller",
          "to_lifeline": "life_user",
          "label": "return {prt, pulseWidth}",
          "type": "association",
          "order": 2,
          "y": 230.0,
          "note": "返回远程模式对应的PRT和脉宽"
        },
        {
          "id": "msg_generate_signal",
          "from_lifeline": "life_user",
          "to_lifeline": "life_tx_coordinator",
          "label": "generateTransmitSignal(prt, pw, Fs)",
