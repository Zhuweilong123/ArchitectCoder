          "type": "sync",
          "order": 11,
          "y": 590.0,
          "note": "按目标双程时延叠加延迟回波，并以 20 dB SNR 叠加复高斯白噪声"
        },
        {
          "id": "msg_flow_012",
          "from_lifeline": "life_echo",
          "to_lifeline": "life_main",
