          "order": 1,
          "y": 190.0,
          "note": "切换到远程模式并记录当前模式"
        },
        {
          "id": "msg_flow_002",
          "from_lifeline": "life_mode",
          "to_lifeline": "life_main",
          "label": "return",
          "type": "return",
          "order": 2,
          "y": 230.0,
