          "order": 9,
          "y": 510.0,
          "note": "注入三个点目标：5 km、25 km、150 km"
        },
        {
          "id": "msg_flow_010",
          "from_lifeline": "life_echo",
          "to_lifeline": "life_main",
          "label": "return",
          "type": "return",
          "order": 10,
          "y": 550.0,
          "note": "确认场景目标就绪"
        },
        {
          "id": "msg_flow_011",
          "from_lifeline": "life_main",
          "to_lifeline": "life_echo",
