# Copy to backend/.env and fill in every deployment-specific value.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL_ID=your-model-id
STRICT_PRODUCTION=true
DEBUG=false
# Generate a random credential; this placeholder deliberately fails startup.
INTERNAL_API_TOKEN=replace-with-a-random-token-at-least-32-bytes
API_HOST=127.0.0.1
API_PORT=8001
# Match the actual browser origin, including scheme and port. Use HTTPS for
# remote access, behind a reverse proxy that forwards WebSocket upgrade headers.
CORS_ORIGINS=["https://architectcoder.example.com"]
# Existing absolute project directory; comma-separated for multiple projects.
WORKSPACE_ROOTS=/srv/architectcoder/workspaces/customer-project
# Paths below are resolved from backend/ unless absolute.
PROJECT_DIR=../project
RUNTIME_DIR=../temp
