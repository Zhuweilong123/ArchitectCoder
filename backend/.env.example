# ── OpenAI-compatible LLM ──────────────────────────
# Configure any compatible provider or self-hosted endpoint.
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=your-model-id

# ── Optional Plugins ────────────────────────────────
# Orchestration and knowledge-graph tools are conservative opt-in features.
# Set their switches to true only after validating the extra planning or
# structural-exploration cost for your deployment.
AGENT_ORCHESTRATION_ENABLED=false
AGENT_ORCHESTRATOR_PROVIDER=extensions.orchestration:create
# Requires orchestration and knowledge graph to be enabled. Off preserves the
# configured orchestration provider's current behavior.
AGENT_ARCHITECTURE_SCHEDULING_ENABLED=false
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_PROVIDER=extensions.memory:create
AGENT_TRACE_ENABLED=true
AGENT_TRACE_PROVIDER=extensions.trace:create
AGENT_EVALS_ENABLED=true
AGENT_EVALS_PROVIDER=extensions.evals:create
AGENT_KNOWLEDGE_GRAPH_ENABLED=false
AGENT_KNOWLEDGE_GRAPH_PROVIDER=extensions.knowledge_graph:create
AGENT_SKILLS_ENABLED=true
AGENT_SKILLS_PROVIDER=extensions.skills:create
# Generated read-only execution plan and Mermaid graphs; default: backend/.architectcoder/plugins
# PLUGIN_PLAN_DIR=/path/to/generated/plugin-plan
# Scan additional roots for direct child directories containing plugin.json.
# Repository extensions/ is always scanned. Relative paths resolve from backend/.
# PLUGIN_ROOTS=["../examples/plugins"]
# Deployment overrides: explicit AGENT_* environment settings take precedence.
# PLUGIN_CONFIG_FILE=config/plugin-overrides.example.json
# Compatibility: additional declarations in the previous central list format.
# PLUGIN_MANIFEST_FILE=config/plugins.example.json

# ── Internal API Auth ───────────────────────────────
# Set this to a secret token to protect API reads, writes and Agent connections.
# Frontend must set VITE_API_TOKEN to the same value in frontend/.env.local
# Leave empty during local dev to skip auth entirely.
INTERNAL_API_TOKEN=

# Local launch is loopback-only. Non-loopback hosts require STRICT_PRODUCTION.
API_HOST=127.0.0.1
API_PORT=8001
STRICT_PRODUCTION=false
DEBUG=true
# External projects must be explicitly allowed; safe=false never bypasses this.
# WORKSPACE_ROOTS=D:/projects/my-project

# File storage
# Relative UML_DIR paths are resolved from the backend directory, independent
# of the shell's current working directory. This keeps trace/eval/memory data
# under the repository's temp/ tree when using the default value.
# UML_DIR=../temp/uml_files
