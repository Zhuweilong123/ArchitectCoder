{
  "schema_version": 1,
  "id": "design_contract",
  "version": "1.1.0",
  "slot": "design_contract",
  "provider": "extensions.design_contract:create",
  "enabled_by_default": true,
  "settings": {
    "enabled": "agent_design_contract_enabled",
    "provider": "agent_design_contract_provider"
  },
  "interfaces": {
    "collect": {
      "stage": "finalize",
      "required": true,
      "async": false
    },
    "collect_facts": {
      "stage": "finalize",
      "required": false,
      "async": false
    },
    "snapshot_from_facts": {
      "stage": "finalize",
      "required": false,
      "async": false
    },
    "evaluate": {
      "stage": "finalize",
      "required": false,
      "async": true
    },
    "finalize": {
      "stage": "finalize",
      "required": false,
      "async": true
    },
    "analyze": {
      "stage": "finalize",
      "required": false,
      "async": true
    }
  },
  "defaults": {},
  "dependencies": [],
  "contributions": [
    {"id": "design_contract.assembly.bind", "stage": "initialize", "handler": "extensions.design_contract.assembly:bind", "mode": "service", "scope": "invocation", "interface_id": "assembly.bind"},
    {
      "id": "design_contract.execution.check",
      "stage": "finalize",
      "handler": "extensions.design_contract.execution:check",
      "mode": "service",
      "scope": "invocation",
      "interface_id": "execution.check"
    },
    {
      "id": "design_contract.execution.rejected",
      "stage": "finalize",
      "handler": "extensions.design_contract.execution:rejected",
      "mode": "service",
      "scope": "invocation",
      "interface_id": "execution.rejected"
    },
    {
      "id": "design_contract.execution.committed",
      "stage": "finalize",
      "handler": "extensions.design_contract.execution:committed",
      "mode": "service",
      "scope": "invocation",
      "interface_id": "execution.committed"
    }
  ],
  "optional_dependencies": [
    "knowledge_graph"
  ]
}
