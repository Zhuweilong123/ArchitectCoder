{
  "schema_version": 1,
  "id": "memory",
  "version": "1.0.0",
  "slot": "memory",
  "provider": "extensions.memory:create",
  "enabled_by_default": true,
  "settings": {
    "enabled": "agent_memory_enabled",
    "provider": "agent_memory_provider",
    "prefix": "agent_memory_"
  },
  "interfaces": {
    "recall": {
      "stage": "prepare",
      "required": true,
      "async": true
    },
    "archive": {
      "stage": "finalize",
      "required": true,
      "async": true
    },
    "reinforce": {
      "stage": "finalize",
      "required": true,
      "async": true
    },
    "observe": {
      "stage": "tool_after",
      "required": false,
      "async": true
    }
  },
  "defaults": {
    "db_path": "",
    "recall_top_k": 3,
    "recall_max_tokens": 500
  },
  "dependencies": [],
  "contributions": [
    {"id": "memory.assembly.bind", "stage": "initialize", "handler": "extensions.memory.assembly:bind", "mode": "service", "scope": "invocation", "interface_id": "assembly.bind"},
    {"id": "memory.context.prepare", "stage": "prepare", "handler": "extensions.memory.contributions:prepare", "mode": "transform"},
    {"id": "memory.run.start", "stage": "run_start", "handler": "extensions.memory.contributions:run_start", "mode": "observer"},
    {"id": "memory.evidence.observe", "stage": "tool_after", "handler": "extensions.memory.contributions:tool_after", "mode": "observer"},
    {"id": "memory.context.refresh", "stage": "model_before", "handler": "extensions.memory.contributions:model_before", "mode": "transform"},
    {"id": "memory.task.archive", "stage": "task_after", "handler": "extensions.memory.contributions:task_after", "mode": "observer"}
  ]
}
